rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return isSignedIn() && profile().active == true;
    }
    function role() {
      return profile().role;
    }
    function isAdmin() {
      return isActive() && role() == "admin";
    }
    function isAdminOrDirector() {
      return isActive() && (role() == "admin" || role() == "director");
    }
    function isStaff() {
      return isActive() && (role() == "admin" || role() == "director" || role() == "educator");
    }

    match /users/{uid} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /rooms/{roomId} {
      allow read: if isActive();
      allow create, update, delete: if isAdminOrDirector();
    }
    match /students/{studentId} {
      allow read: if isActive();
      allow create, update, delete: if isAdminOrDirector();
    }
    match /attendance/{recordId} {
      allow read: if isActive();
      allow create, update, delete: if isStaff();
    }
    match /duties/{dutyId} {
      allow read: if isActive();
      allow write: if isAdminOrDirector();
    }
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isActive();
      allow update, delete: if false;
    }
  }
}